# Firebase Admin SDK (from chaos-or-release-v2 project)
FIREBASE_PROJECT_ID=chaos-or-release-v2
FIREBASE_CLIENT_EMAIL=your-service-account@chaos-or-release-v2.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://chaos-or-release-v2-default-rtdb.firebaseio.com

# Redis (Railway provides this automatically when you add Redis plugin)
REDIS_URL=redis://localhost:6379

# Game passwords
ADMIN_PASSWORD=admin123
PROJECTOR_PASSWORD=projector123

# Server
PORT=3000
